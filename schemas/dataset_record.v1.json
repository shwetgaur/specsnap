{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specsnap.dev/schemas/dataset_record.v1.json",
  "title": "SpecSnap Dataset Record",
  "type": "object",
  "required": [
    "sample_id",
    "image_path",
    "nl_objective",
    "nl_expected_outcome",
    "ground_truth_steps",
    "app_category",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "sample_id": { "type": "string" },
    "image_path": { "type": "string" },
    "nl_objective": { "type": "string" },
    "nl_expected_outcome": { "type": "string" },
    "ground_truth_steps": {
      "type": "array",
      "items": { "type": "object" }
    },
    "app_category": {
      "type": "string",
      "enum": ["login", "e-commerce", "settings", "navigation", "forms"]
    },
    "source": {
      "type": "string",
      "enum": ["rico", "mobilityui", "manual_web", "synthetic"]
    }
  }
}
